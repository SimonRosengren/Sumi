MONGODB_URI=mongodb://localhost:27018/sumi?replicaSet=rs0&directConnection=true
PORT=3000
# Web dev server proxies /api here (default http://localhost:3000)
# SUMI_API_URL=http://localhost:3000
# CLI (pnpm exec sumi): token from `pnpm bootstrap <name>`
SUMI_URL=http://localhost:3000
SUMI_TOKEN=
# GitHub sign-in (docs/adr/0021-github-sign-in-and-token-management.md). Leave empty to use tokens only.
# Create an OAuth app at https://github.com/settings/developers with callback URL
# <SUMI_PUBLIC_URL>/api/auth/github/callback, e.g. http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required with the two above: comma-separated GitHub logins that may sign in.
GITHUB_ALLOWED_LOGINS=
# GitHub webhook that moves tickets as pull requests change (docs/adr/0022-github-webhook-moves-tickets.md).
# Point a repo webhook at <public url>/api/webhooks/github, content type application/json,
# event "Pull requests", and use the same secret here.
GITHUB_WEBHOOK_SECRET=
# Where people open the board (GitHub sends the browser back here).
# SUMI_PUBLIC_URL=http://localhost:5173
