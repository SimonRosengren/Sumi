{
  "name": "sumi",
  "private": true,
  "description": "Open-source, self-hosted alternative to Linear, Jira and Trello: a minimal Kanban ticket tracker with an MCP server and CLI for AI agents.",
  "keywords": [
    "ticket-management",
    "issue-tracker",
    "kanban",
    "project-management",
    "linear-alternative",
    "jira-alternative",
    "trello-alternative",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "self-hosted",
    "open-source"
  ],
  "homepage": "https://github.com/SimonRosengren/Sumi#readme",
  "repository": { "type": "git", "url": "git+https://github.com/SimonRosengren/Sumi.git" },
  "bugs": { "url": "https://github.com/SimonRosengren/Sumi/issues" },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:db": "docker compose up -d --wait mongo",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "dev:api": "pnpm --filter @sumi/api dev",
    "bootstrap": "pnpm --filter @sumi/api bootstrap",
    "dev:web": "pnpm --filter @sumi/web dev",
    "dev": "pnpm dev:db && concurrently -n api,web -c yellow,green --kill-others-on-fail \"pnpm dev:api\" \"pnpm dev:web\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sumi/cli": "workspace:*",
    "@sumi/mcp": "workspace:*",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
